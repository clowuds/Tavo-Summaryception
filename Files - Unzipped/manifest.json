{
  "specVersion": 2,
  "id": "com.bitbear.summaryception",
  "name": {
    "$t": "plugin.name"
  },
  "version": "5.8.1",
  "entry": "actions.js",
  "author": "Clowud & Sandwichers",
  "cover": "cover.png",
  "description": {
    "$t": "plugin.description"
  },
  "localization": {
    "defaultLocale": "en",
    "resources": {
      "en": "locales/en.json",
      "es": "locales/es.json",
      "zh-CN": "locales/zh-CN.json"
    }
  },
  "minAppVersion": "0.93.0",
  "permissions": [
    "generate",
    "variable",
    "message",
    "network"
  ],
  "contributes": {
    "inputActions": [
      {
        "id": "sc-open-panel",
        "label": {
          "$t": "actions.openPanel"
        }
      },
      {
        "id": "sc-force",
        "label": {
          "$t": "actions.force"
        }
      },
      {
        "id": "sc-stop",
        "label": {
          "$t": "actions.stop"
        }
      },
      {
        "id": "sc-clear",
        "label": {
          "$t": "actions.clear"
        }
      }
    ],
    "sidebar": [
      {
        "id": "sc-open-panel",
        "label": {
          "$t": "sidebar.openPanel"
        }
      },
      {
        "id": "sc-force",
        "label": {
          "$t": "sidebar.force"
        }
      },
      {
        "id": "sc-stop",
        "label": {
          "$t": "sidebar.stop"
        }
      },
      {
        "id": "sc-clear",
        "label": {
          "$t": "sidebar.clear"
        }
      }
    ],
    "htmlFragments": [
      {
        "id": "summaryception-lang",
        "src": "ui/lang-sc.html",
        "mount": "/chat/head/end"
      },
      {
        "id": "summaryception-panel",
        "src": "ui/panel-sc.html",
        "mount": "/chat/body/end"
      }
    ],
    "settings": {
      "schema": [
        {
          "type": "info",
          "text": {
            "$t": "settings.info"
          },
          "icon": "info"
        },
        {
          "key": "outputLanguage",
          "type": "select",
          "label": {
            "$t": "settings.outputLanguage.label"
          },
          "default": "auto",
          "options": [
            "auto",
            "English",
            "Spanish",
            "French",
            "German",
            "Italian",
            "Portuguese",
            "Russian",
            "Chinese",
            "Japanese",
            "Korean",
            "Arabic",
            "Dutch",
            "Polish",
            "Swedish",
            "Turkish"
          ]
        },
        {
          "key": "uiLanguage",
          "type": "select",
          "label": {
            "$t": "settings.uiLanguage.label"
          },
          "default": "auto",
          "options": [
            "auto",
            "English",
            "Spanish",
            "Portuguese",
            "German",
            "Chinese",
            "Japanese"
          ]
        },
        {
          "type": "divider"
        },
        {
          "key": "hideFab",
          "type": "switch",
          "label": {
            "$t": "settings.hideFab.label"
          },
          "default": false
        },
        {
          "key": "fixedFab",
          "type": "switch",
          "label": {
            "$t": "settings.fixedFab.label"
          },
          "default": false
        },
        {
          "type": "divider"
        },
        {
          "key": "perChatSettings",
          "type": "switch",
          "label": {
            "$t": "settings.perChatSettings.label"
          },
          "tip": {
            "$t": "settings.perChatSettings.tip"
          },
          "default": false
        },
        {
          "type": "break"
        },
        {
          "type": "info",
          "text": {
            "$t": "settings.defaultsInfo.text"
          },
          "icon": "info"
        },
        {
          "key": "default_enabled",
          "type": "switch",
          "label": {
            "$t": "settings.enabled.label"
          },
          "default": true
        },
        {
          "key": "default_pauseSummarization",
          "type": "switch",
          "label": {
            "$t": "settings.pauseSummarization.label"
          },
          "default": false
        },
        {
          "key": "default_disableGhosting",
          "type": "switch",
          "label": {
            "$t": "settings.disableGhosting.label"
          },
          "default": false
        },
        {
          "key": "default_noSummarizeVerbatim",
          "type": "switch",
          "label": {
            "$t": "settings.noSummarizeVerbatim.label"
          },
          "default": true
        },
        {
          "key": "default_triggeredMemoriesEnabled",
          "type": "switch",
          "label": {
            "$t": "settings.triggeredMemoriesEnabled.label"
          },
          "default": true
        },
        {
          "key": "default_secondaryPromptEnabled",
          "type": "switch",
          "label": {
            "$t": "settings.secondaryPromptEnabled.label"
          },
          "default": true
        },
        {
          "key": "default_autoRepair",
          "type": "switch",
          "label": {
            "$t": "settings.autoRepair.label"
          },
          "default": false
        },
        {
          "key": "default_verbatimTurns",
          "type": "slider",
          "label": {
            "$t": "settings.verbatimTurns.label"
          },
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 2
        },
        {
          "key": "default_turnsPerSummary",
          "type": "slider",
          "label": {
            "$t": "settings.turnsPerSummary.label"
          },
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 2
        },
        {
          "key": "default_snippetsPerLayer",
          "type": "slider",
          "label": {
            "$t": "settings.snippetsPerLayer.label"
          },
          "min": 5,
          "max": 100,
          "step": 5,
          "default": 20
        },
        {
          "key": "default_snippetsPerPromotion",
          "type": "slider",
          "label": {
            "$t": "settings.snippetsPerPromotion.label"
          },
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 3
        },
        {
          "key": "default_snippetsKeptAfterPromotion",
          "type": "slider",
          "label": {
            "$t": "settings.snippetsKeptAfterPromotion.label"
          },
          "min": 0,
          "max": 50,
          "step": 1,
          "default": 5
        },
        {
          "key": "default_maxLayers",
          "type": "slider",
          "label": {
            "$t": "settings.maxLayers.label"
          },
          "min": 1,
          "max": 100,
          "step": 1,
          "default": 10
        },
        {
          "key": "default_autoRepairInterval",
          "type": "slider",
          "label": {
            "$t": "settings.autoRepairInterval.label"
          },
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 5
        },
        {
          "key": "default_triggeredMemoryLookback",
          "type": "slider",
          "label": {
            "$t": "settings.triggeredMemoryLookback.label"
          },
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 4
        },
        {
          "key": "default_triggeredMemoryCap",
          "type": "slider",
          "label": {
            "$t": "settings.triggeredMemoryCap.label"
          },
          "min": 1,
          "max": 50,
          "step": 1,
          "default": 3
        },
        {
          "key": "default_promptPreset",
          "type": "select",
          "label": {
            "$t": "settings.promptPreset.label"
          },
          "default": "narrative",
          "options": [
            {
              "value": "narrative",
              "label": {
                "$t": "settings.promptPreset.narrative"
              }
            },
            {
              "value": "gamestate",
              "label": {
                "$t": "settings.promptPreset.gamestate"
              }
            },
            {
              "value": "custom",
              "label": {
                "$t": "settings.promptPreset.custom"
              }
            }
          ]
        },
        {
          "key": "default_secondaryPromptPreset",
          "type": "select",
          "label": {
            "$t": "settings.secondaryPromptPreset.label"
          },
          "default": "light",
          "options": [
            {
              "value": "light",
              "label": {
                "$t": "settings.secondaryPromptPreset.light"
              }
            },
            {
              "value": "heavy",
              "label": {
                "$t": "settings.secondaryPromptPreset.heavy"
              }
            },
            {
              "value": "custom",
              "label": {
                "$t": "settings.secondaryPromptPreset.custom"
              }
            }
          ]
        }
      ]
    }
  }
}
